         };
-        let code = &rest[..end];
+        let terminator = rest.as_bytes()[terminator_idx];
+        let code = &rest[..terminator_idx];
+        rest = &rest[terminator_idx + 1..];
+        if terminator != b'm' {
+            continue;
+        }
         if !(code.is_empty() || code == "0") {
             return true;
         }
-        rest = &rest[end + 1..];
     }
     false
 }
